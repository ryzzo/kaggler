# Copy to .env (git-ignored) — `docker compose up --build` reads it automatically,
# so no extra flags or exported variables are needed.
#   cp .env.example .env && docker compose up --build

# Layer the NVIDIA GPU override onto the base file (needs the NVIDIA Container Toolkit).
# Delete this line on a machine without an NVIDIA GPU.
COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml

# Build the isolated pytabkit venv into the image and use it for model scouting.
INSTALL_PYTABKIT=1
KAGGLER_SCOUT_ENGINE=pytabkit

# PyTorch build for the pytabkit venv: CUDA 12.4 wheels (work with CUDA 12/13 drivers).
# Use https://download.pytorch.org/whl/cpu for a CPU-only machine.
TORCH_INDEX=https://download.pytorch.org/whl/cu124
